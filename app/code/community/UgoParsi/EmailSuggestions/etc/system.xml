<config>
    <sections>
        <customer>
            <groups>
                <email_suggestions translate="label" module="core">
                    <label>Email Suggestions</label>
                    <sort_order>910</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <check_domain translate="label comment">
                            <label>Check email domains</label>
                            <comment>Warn customers when the domain has no mail records. The check sends only the domain and never blocks submission.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </check_domain>
                    </fields>
                </email_suggestions>
            </groups>
        </customer>
        <system>
            <groups>
                <rate_limit>
                    <fields>
                        <email_suggestions_domain translate="label comment" module="core">
                            <label>Email domain check (storefront)</label>
                            <comment>Per IP address across all store views. Default 30 per minute. 0 to disable the limit.</comment>
                            <sort_order>290</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <validate>validate-digits validate-zero-or-greater</validate>
                        </email_suggestions_domain>
                    </fields>
                </rate_limit>
            </groups>
        </system>
    </sections>
</config>
